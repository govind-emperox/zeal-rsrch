# Copy this file to .env and replace the password before starting PostgreSQL.
POSTGRES_USER=rsrch
POSTGRES_PASSWORD=replace-with-a-strong-local-password
POSTGRES_DB=rsrch
DATABASE_URL=postgresql://rsrch:replace-with-a-strong-local-password@localhost:54320/rsrch
STORAGE_ROOT=./.rsrch-storage
# Optional Codex worker overrides. The authenticated account default model is used when CODEX_MODEL is unset.
CODEX_WORKSPACE_ROOT=/absolute/path/to/zeal-rsrch
# CODEX_COMMAND=codex
# CODEX_MODEL=gpt-5.6-terra
# CODEX_EFFORT=medium
